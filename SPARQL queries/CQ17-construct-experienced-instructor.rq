# Construct new triples, defining a new class called "Experienced Instructor", which contains all and only instructors who have taught at least 5 course offerings.

PREFIX : <https://firdaus-gupte.github.io/umass-philosophy/> 
PREFIX owl: <http://www.w3.org/2002/07/owl#> 
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX xml: <http://www.w3.org/XML/1998/namespace> 
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> 
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> 
PREFIX umphil: <https://firdaus-gupte.github.io/umass-philosophy/> 

CONSTRUCT{
  ?Instructor rdf:type umphil:ExperiencedInstructor
}



WHERE{
  
  SELECT ?Instructor (COUNT(DISTINCT ?CourseOffering) AS ?CoursesTaught)
  
  WHERE{
 ?CourseOffering umphil:isTaughtBy ?Instructor .



  
}
GROUP BY ?Instructor
HAVING (COUNT(DISTINCT ?CourseOffering) >= 5)

}
