# CQ13: How many experienced instructors do we have at UMass?
# (How many instructors at UMass have taught at least 4 course offerings over the last 2 years, from Fall 2024 to Summer 2026?)

PREFIX umphil: <https://firdaus-gupte.github.io/umass-philosophy/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT (COUNT(DISTINCT ?InstructorPerson) AS ?NumberOfExperiencedInstructors)

WHERE {

  {
SELECT ?InstructorPerson (COUNT(DISTINCT ?CourseOffering) AS ?NumberOfOfferings )

WHERE {

  VALUES ?LastTwoYearTerm {
  umphil:Summer2026
  umphil:Spring2026
  umphil:Winter2026
  umphil:Fall2025
  umphil:Summer2025
  umphil:Spring2025
  umphil:Winter2025
  umphil:Fall2024
  
}
  
  ?CourseOffering umphil:isOfferedInTerm ?LastTwoYearTerm ;
    		umphil:isOfferingOf ?Course ;
      		umphil:isTaughtBy ?InstructorPerson .
  
  
            
  
  		

 ?Course a umphil:PhilosophyCourse .
  
  
 
}
GROUP BY ?InstructorPerson
HAVING (COUNT(DISTINCT ?CourseOffering) >= 4)
  }
}