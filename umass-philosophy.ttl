@prefix : <https://firdaus-gupte.github.io/umass-philosophy/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix umphil: <https://firdaus-gupte.github.io/umass-philosophy/> .
@base <https://firdaus-gupte.github.io/umass-philosophy/> .

<https://firdaus-gupte.github.io/umass-philosophy/> rdf:type owl:Ontology ;
                                                     owl:versionIRI <https://firdaus-gupte.github.io/umass-philosophy/1.0.0> ;
                                                     owl:imports <https://www.commoncoreontologies.org/2026-04-04/CommonCoreOntologiesMerged> .

#################################################################
#    Object Properties
#################################################################

###  https://firdaus-gupte.github.io/umass-philosophy/hasOffering
umphil:hasOffering rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000058> ;
                   owl:inverseOf umphil:isOfferingOf ;
                   rdfs:domain umphil:Course ;
                   rdfs:range umphil:CourseOffering ;
                   rdfs:label "has Offering" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Inverse of the relation is Offering Of" .


###  https://firdaus-gupte.github.io/umass-philosophy/isOfferedInTerm
umphil:isOfferedInTerm rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdfs:domain umphil:CourseOffering ;
                       rdfs:range umphil:AcademicTerm ;
                       rdfs:label "is Offered In Term" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "is Offered In Term is a relation between a particular course offering (e.g. PHIL160 taught by Kornblith in Fall 2026) and the particular academic term (e.g. Fall 2026) in which the course offering was offered" .


###  https://firdaus-gupte.github.io/umass-philosophy/isOfferingOf
umphil:isOfferingOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.obolibrary.org/obo/BFO_0000059> ;
                    rdfs:domain umphil:CourseOffering ;
                    rdfs:range umphil:Course ;
                    rdfs:comment "Multiple course offerings can be an offering of a single course." ;
                    rdfs:label "is Offering Of" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "is Offering Of is a relation between a particular course offering  (e.g. PHIL160 taught by Kornblith in Fall 2026) and the course that it is an offering of (e.g. PHIL160)" .


###  https://firdaus-gupte.github.io/umass-philosophy/isTaughtBy
umphil:isTaughtBy rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <https://www.commoncoreontologies.org/ont00001833> ;
                  owl:inverseOf umphil:teaches ;
                  rdfs:domain umphil:CourseOffering ;
                  rdfs:range umphil:InstructorPerson ;
                  rdfs:label "is Taught By" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "is Taught By is a relation between a particular course offering  (e.g. PHIL160 taught by Kornblith in Fall 2026) and the instructor who teaches the course (e.g. Kornblith)" .


###  https://firdaus-gupte.github.io/umass-philosophy/satisfiesCourseDistributionRequirement
umphil:satisfiesCourseDistributionRequirement rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf owl:topObjectProperty ;
                                              rdfs:domain umphil:Course ;
                                              rdfs:range umphil:CourseDistributionRequirement ;
                                              rdfs:label "satisfies Course Distribution Requirement" ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "satisfies Course Distribution Requirement is a relation between a course (e.g. PHIL110) and the course distribution requirement that it satisfies (e.g. Logic Requirement)" .


###  https://firdaus-gupte.github.io/umass-philosophy/teaches
umphil:teaches rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <https://www.commoncoreontologies.org/ont00001787> ;
               rdfs:domain umphil:InstructorPerson ;
               rdfs:range umphil:CourseOffering ;
               rdfs:label "teaches" ;
               <http://www.w3.org/2004/02/skos/core#definition> "Inverse of the relation is Taught By" .


#################################################################
#    Data properties
#################################################################

###  https://firdaus-gupte.github.io/umass-philosophy/hasCourseNumber
umphil:hasCourseNumber rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain umphil:Course ;
                       rdfs:range xsd:integer ;
                       rdfs:comment "This relation was added to sort courses into upper- and lower-division courses. A course with a course number >= 300 is an upper-division course, whereas a course with a course number <300 is a lower-division course." ;
                       rdfs:label "has Course Number" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "has Course Number is a relation between a course (e.g. PHIL160) and the integer that corresponds to its course number (e.g. 160)" .


###  https://firdaus-gupte.github.io/umass-philosophy/hasCourseTitle
umphil:hasCourseTitle rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain umphil:Course ;
                      rdfs:range xsd:string ;
                      rdfs:label "has Course Title" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "has Course Title is a relation between a course (e.g. PHIL160) and its human-readable, English title (e.g. \"Introduction to Ethics\")" .


#################################################################
#    Classes
#################################################################

###  https://firdaus-gupte.github.io/umass-philosophy/AcademicTerm
umphil:AcademicTerm rdf:type owl:Class ;
                    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
                    rdfs:label "Academic Term" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "An Academic Term is a Temporal Interval in which a particular Course Offering is offered, in the present, past, or future, and that is typically approximately 3.5 months long." ;
                    <http://www.w3.org/2004/02/skos/core#example> "Fall 2022; Spring 2026; Fall 2026" .


###  https://firdaus-gupte.github.io/umass-philosophy/Course
umphil:Course rdf:type owl:Class ;
              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ;
              rdfs:label "Course" ;
              <http://www.w3.org/2004/02/skos/core#definition> "A Course is a generically dependent continuant that is a repeatable unit of instruction, that may have a Course Offering, typically identified by a Course Code, and typically has a Course Number and Course Title." ;
              <http://www.w3.org/2004/02/skos/core#example> "PHIL100 (Introduction to Philosophy); MATH131 (Calculus I)" .


###  https://firdaus-gupte.github.io/umass-philosophy/CourseDistributionRequirement
umphil:CourseDistributionRequirement rdf:type owl:Class ;
                                     rdfs:subClassOf umphil:CourseRequirement ;
                                     rdfs:label "Course Distribution Requirement" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A Course Distribution Requirement is a Course Requirement that requires a student to enroll in a course in a particular subject or area" ;
                                     <http://www.w3.org/2004/02/skos/core#example> "Logic Requirement; Metaphysics and Epistemology Requirement" .


###  https://firdaus-gupte.github.io/umass-philosophy/CourseOffering
umphil:CourseOffering rdf:type owl:Class ;
                      rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000463> ;
                      rdfs:label "Course Offering" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A Course Offering is an Act of Educational Training Instruction that is an offering of a course, during a particular academic term, taught by one or more particular Instructor Persons." ;
                      <http://www.w3.org/2004/02/skos/core#example> "The course offering of the course PHIL100 (which has the Course Title \"Introduction to Philosophy\"), offered in the academic term Fall 2022 by the Instructor Person Markosian." .


###  https://firdaus-gupte.github.io/umass-philosophy/CourseRequirement
umphil:CourseRequirement rdf:type owl:Class ;
                         rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000965> ;
                         rdfs:label "Course Requirement" ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A Course Requirement is a prescriptive information content entity that requires a student to enroll in a course offering of a course of a specific type." .


###  https://firdaus-gupte.github.io/umass-philosophy/HistoryACourse
umphil:HistoryACourse rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( umphil:PhilosophyCourse
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty umphil:satisfiesCourseDistributionRequirement ;
                                                                   owl:hasValue umphil:HistoryARequirement
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:label "History A Course" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A History A Course is a Philosophy course that satisfies the course distribution requirement History A." .


###  https://firdaus-gupte.github.io/umass-philosophy/HistoryBCourse
umphil:HistoryBCourse rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( umphil:PhilosophyCourse
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty umphil:satisfiesCourseDistributionRequirement ;
                                                                   owl:hasValue umphil:HistoryBRequirement
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:label "History B Course" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A History B Course is a Philosophy course that satisfies the course distribution requirement History B." .


###  https://firdaus-gupte.github.io/umass-philosophy/InPersonCourseOffering
umphil:InPersonCourseOffering rdf:type owl:Class ;
                              rdfs:subClassOf umphil:CourseOffering ;
                              owl:disjointWith umphil:OnlineCourseOffering ;
                              rdfs:label "In Person Course Offering" ;
                              <http://www.w3.org/2004/02/skos/core#definition> "An In Person Course Offering is a Course Offering that has a primary modality of instruction of in-person." .


###  https://firdaus-gupte.github.io/umass-philosophy/InstructorPerson
umphil:InstructorPerson rdf:type owl:Class ;
                        rdfs:subClassOf <https://www.commoncoreontologies.org/ont00001262> ;
                        rdfs:label "Instructor Person" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "An Instructor Person is a Person who has taught, is teaching, or will teach a Course." .


###  https://firdaus-gupte.github.io/umass-philosophy/LogicCourse
umphil:LogicCourse rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( umphil:PhilosophyCourse
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty umphil:satisfiesCourseDistributionRequirement ;
                                                                owl:hasValue umphil:LogicRequirement
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:label "Logic Course" ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A Logic Course is a Philosophy course that satisfies the course distribution requirement Logic." .


###  https://firdaus-gupte.github.io/umass-philosophy/LowerDivisionCourse
umphil:LowerDivisionCourse rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( umphil:Course
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty umphil:hasCourseNumber ;
                                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                             owl:onDatatype xsd:integer ;
                                                                                             owl:withRestrictions ( [ xsd:maxExclusive 300
                                                                                                                    ]
                                                                                                                  )
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           owl:disjointWith umphil:UpperDivisionCourse ;
                           rdfs:label "Lower Division Course" ;
                           <http://www.w3.org/2004/02/skos/core#definition> "A Lower Division Course is a course that has a Course Number < 300." .


###  https://firdaus-gupte.github.io/umass-philosophy/MetaphysicsEpistemologyCourse
umphil:MetaphysicsEpistemologyCourse rdf:type owl:Class ;
                                     owl:equivalentClass [ owl:intersectionOf ( umphil:PhilosophyCourse
                                                                                [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty umphil:satisfiesCourseDistributionRequirement ;
                                                                                  owl:hasValue umphil:MetaphysicsEpistemologyRequirement
                                                                                ]
                                                                              ) ;
                                                           rdf:type owl:Class
                                                         ] ;
                                     rdfs:label "Metaphysics & Epistemology Course" ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "A Metaphysics & Epistemology Course is a Philosophy course that satisfies the course distribution requirement Metaphysics & Epistemology." .


###  https://firdaus-gupte.github.io/umass-philosophy/OnlineCourseOffering
umphil:OnlineCourseOffering rdf:type owl:Class ;
                            rdfs:subClassOf umphil:CourseOffering ;
                            rdfs:label "Online Course Offering" ;
                            <http://www.w3.org/2004/02/skos/core#definition> "An Online Course Offering is a Course Offering that has a primary modality of instruction of online." .


###  https://firdaus-gupte.github.io/umass-philosophy/PhilosophyCourse
umphil:PhilosophyCourse rdf:type owl:Class ;
                        rdfs:subClassOf umphil:Course ;
                        rdfs:label "Philosophy Course" ;
                        <http://www.w3.org/2004/02/skos/core#definition> "A Philosophy Course is a Course provided by the Philosophy Department, with primarily Philosophical content." ;
                        <http://www.w3.org/2004/02/skos/core#example> "PHIL100 (Introduction to Philosophy); PHIL169 (Introduction to Ethics)" .


###  https://firdaus-gupte.github.io/umass-philosophy/UpperDivisionCourse
umphil:UpperDivisionCourse rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( umphil:Course
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty umphil:hasCourseNumber ;
                                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                             owl:onDatatype xsd:integer ;
                                                                                             owl:withRestrictions ( [ xsd:minInclusive 300
                                                                                                                    ]
                                                                                                                  )
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:label "Upper Division Course" ;
                           <http://www.w3.org/2004/02/skos/core#definition> "An Upper Division Course is a course that has a Course Number >= 300." .


###  https://firdaus-gupte.github.io/umass-philosophy/ValueTheoryCourse
umphil:ValueTheoryCourse rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( umphil:PhilosophyCourse
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty umphil:satisfiesCourseDistributionRequirement ;
                                                                      owl:hasValue umphil:ValueTheoryRequirement
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:label "Value Theory Course" ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A Value Theory Course is a Philosophy course that satisfies the course distribution requirement Value Theory." .


